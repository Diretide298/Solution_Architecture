             {"scroll": 430}, {"wait": 800}, {"click": "104"}, {"wait": 4000}],
   "expect": ["Direct seat map", "Whole map", "Section 104", "Premium · AED 245"]},

  {"id": "GST-041", "name": "Checkout Entry", "view": "Cart (header basket, after a booking is added to the cart)",
