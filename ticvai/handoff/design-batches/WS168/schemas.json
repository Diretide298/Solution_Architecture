   "code",
   "displayLabel",
   "amount",
   "effectiveFrom"
  ],
  "properties": {
   "id": {
    "type": "string",
    "format": "uuid",
    "readOnly": true
   },
   "seatCategoryId": {
    "type": "string",
    "format": "uuid",
    "readOnly": true
   },
   "code": {
    "type": "string",
    "maxLength": 64,
    "description": "Unique within the category."
   },
   "displayLabel": {
    "type": "string",
    "maxLength": 200
   },
   "displayColour": {
    "type": "string",
    "nullable": true,
    "pattern": "^#[0-9A-Fa-f]{6}$"
   },
