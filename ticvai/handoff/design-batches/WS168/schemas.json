     "type": "string",
     "format": "uuid"
    }
   },
   "kind": {
    "type": "string",
    "enum": [
     "soldTwice",
     "soldNotMarked",
     "markedNotSold",
     "heldAndSold",
     "orphanedHold"
    ]
   },
   "detectedAt": {
    "type": "string",
    "format": "date-time"
   }
  }
 },
