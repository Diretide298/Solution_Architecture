 },
 "FareTable": {
  "x-ticvai-persistence": "transport.fare_table + transport.fare_passenger_type + transport.fare_matrix_cell",
  "allOf": [
   {
    "$ref": "#/components/schemas/SetFareTableRequest"
   },
   {
    "type": "object",
    "required": [
     "id",
     "routeId"
    ],
