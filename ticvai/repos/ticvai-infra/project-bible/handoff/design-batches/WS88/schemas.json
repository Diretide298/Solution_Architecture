        "b2c",
        "pos",
        "mobileApp",
        "callCenter",
        "b2b",
        "accessControl",
        "ticketing",
        "otherDependentServices"
       ]
      },
      "synchronisedAt": {
       "type": "string",
       "format": "date-time",
       "nullable": true
      }
     }
    },
    "description": "Publication (pack p.18): services the configuration is synchronised to"
   },
   "aiInsights": {
