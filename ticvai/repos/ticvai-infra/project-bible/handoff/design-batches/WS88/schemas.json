       ]
      },
      "message": {
       "type": "string"
      }
     }
    },
    "description": "Dependency Health (pack p.17 examples); missingCancellationPolicy is a warning (decided 29 September, readiness close-out)"
   },
   "publicationTargets": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "target": {
       "type": "string",
