digraph c {
  rankdir=LR; bgcolor="transparent";
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=11 color="#D8DEE8"];
  edge [fontname="Helvetica" fontsize=9 color="#5A6577"];
  subgraph cluster_e { label="Ephemeral · one event · 50 seconds of traffic"; style="rounded,filled"; fillcolor="#FDECEC"; fontname="Helvetica"; fontsize=12;
    c1 [label="Catalogue × 20\n4 vCPU / 2 GB" fillcolor="#FFFFFF"];
    c2 [label="Order × 16\n4 vCPU / 2 GB" fillcolor="#FFFFFF"];
    c3 [label="Identity × 6" fillcolor="#FFFFFF"];
    pb [label="pgbouncer\n5000 client conns" fillcolor="#FFF6E0"];
    pg [label="Postgres 16 vCPU / 32 GB\nsynchronous_commit = off\n17 tables of 380" fillcolor="#FFFFFF"];
    rd [label="Redis 16 GB" fillcolor="#FFFFFF"];
    c1 -> pb; c2 -> pb; c3 -> pb; pb -> pg; c1 -> rd [style=dotted]; }
  subgraph cluster_p { label="Permanent platform · shared cell"; style="rounded,filled"; fillcolor="#F4F7FB"; fontname="Helvetica"; fontsize=12;
    p1 [label="Catalogue" fillcolor="#FFFFFF"]; p2 [label="Order" fillcolor="#FFFFFF"];
    p3 [label="sync.rejection\nwhat would not apply" fillcolor="#FFF6E0"]; }
  p1 -> c1 [label="catalogue snapshot\nnot a replica" style=dashed color="#8A6D00"];
  c2 -> p2 [label="reconcile: environment id\n+ monotonic sequence\nidempotent replay" color="#B00020" penwidth=2];
  c2 -> p3 [label="rejected" style=dotted color="#B00020"];
}
