 "deployables": {
  "commerce": {
   "what": "The sale path: order, payment and ledger commit in one transaction. Autoscales on requests per second.",
   "modules": [
    "Catalogue",
    "Identity",
    "Ledger",
    "Order",
    "Tenancy",
    "Wallet"
   ]
  },
  "access": {
   "what": "The gate hot path, flat high rate, offline package. The same module code builds the venue edge node.",
   "modules": [
    "Access"
   ]
  },
  "operations": {
   "what": "Back office and engagement. Nothing that takes money waits on it.",
   "modules": [
    "CrossRegion",
    "Fnb",
    "Inventory",
    "Marketing",
    "Platform",
    "Reporting",
    "Retail",
    "VenueOps",
    "WhiteLabel"
   ]
  },
  "ticvai-ai": {
   "what": "AI, in Python, isolated (ADR-0020): three process groups, read-only on the transactional schemas.",
   "modules": [
    "Ai"
   ]
  },
  "workers": {
   "what": "No module of its own: the outbox relay (one per region, ADR-0058), every module's event consumers and scheduled jobs. Scales on queue depth.",
   "modules": []
  }
 },
 "replicaFloors": [
  {
   "unit": "commerce",
   "deployable": "commerce",
   "floor": 3,
   "why": "One per zone: the sale path survives a zone loss without a cold start"
  },
  {
   "unit": "access",
   "deployable": "access",
   "floor": 2,
   "why": "Cloud side only; the gate decides locally (ADR-0013)"
  },
  {
   "unit": "operations",
   "deployable": "operations",
   "floor": 2,
   "why": "Back office tolerates a short scale-out"
  },
  {
   "unit": "workers",
   "deployable": "workers",
   "floor": 2,
   "why": "Relay leases fail over between replicas (ADR-0058, amended 1 October)"
  },
  {
   "unit": "ai-realtime",
   "deployable": "ticvai-ai",
   "floor": 2,
   "why": "Fraud scoring and recommendations; fail open. 3 in a large cell (AI design 4.3)"
  },
