 "RentalFeePolicy": {
  "type": "object",
  "x-ticvai-persistence": "rental.fee_policy",
  "description": "Board 4.8. **Extension is priced below late return on purpose** — *\"this encourages customers to extend properly rather than returning late.\"*\n",
  "properties": {
   "id": {
    "type": "string",
    "format": "uuid"
   },
   "productId": {
