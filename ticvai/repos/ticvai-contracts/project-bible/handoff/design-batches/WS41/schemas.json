       "type": "string",
       "enum": [
        "processingPurpose",
        "consentPurpose",
        "communicationPreference",
        "capturePoint",
        "cookieBanner",
        "trackingTechnology",
        "minorPrivacyRule",
        "privacyNotice"
       ]
      },
      "configurationId": {
       "type": "string",
       "format": "uuid"
      },
      "version": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "description": "The draft versions in the change set. Required when the set is opened."
   },
   "scenario": {
    "type": "object",
    "description": "For `simulate` (the pack's Test Inputs).",
    "properties": {
     "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
     },
     "brandId": {
      "type": "string",
      "format": "uuid",
      "nullable": true
     },
     "channel": {
      "$ref": "#/components/schemas/ConsentSource"
     },
     "capturePoint": {
      "type": "string",
      "nullable": true
     },
     "customerAge": {
      "type": "integer",
      "minimum": 0,
      "nullable": true
     },
     "customerStatus": {
      "type": "string",
      "enum": [
       "new",
       "returning",
       "member"
      ]
     },
     "productId": {
