    "nullable": true
   },
   "signatory": {
    "type": "object",
    "properties": {
     "subjectId": {
      "type": "string",
      "format": "uuid"
     },
     "name": {
      "type": "string"
     },
     "signatoryType": {
      "type": "string",
      "enum": [
       "participant",
       "guardian",
       "organisationRepresentative"
      ]
     }
    }
   },
   "submitted": {
    "type": "string",
    "format": "date-time",
    "description": "`FormSubmission.submittedAt`, the device time of signing."
   },
   "verificationReason": {
    "type": "string",
    "enum": [
     "configuredManualReview",
     "automaticCheckFailed",
     "minorSignedAsAdult",
     "guardianDiscrepancy",
     "participantMismatch",
     "evidenceRequired",
     "aiAnomaly",
     "sampleReview"
