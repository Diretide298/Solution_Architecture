 "CouponCode": {
  "x-ticvai-persistence": "promotions.coupon_code",
  "type": "object",
  "required": [
   "code",
   "campaignId",
   "status"
  ],
  "properties": {
   "code": {
    "type": "string"
   },
   "campaignId": {
    "type": "string",
    "format": "uuid"
   },
   "status": {
    "$ref": "#/components/schemas/CouponStatus"
   },
   "assignedSubjectId": {
    "type": "string",
    "format": "uuid",
    "nullable": true
   },
