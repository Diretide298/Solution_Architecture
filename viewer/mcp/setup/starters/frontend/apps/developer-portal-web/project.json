{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "developer-portal-web",
  "sourceRoot": "apps/developer-portal-web/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "platform:web",
    "operator:partner",
    "offline:no"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint {projectRoot}/src --ext .ts,.tsx"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root {projectRoot} --passWithNoTests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/developer-portal-web/tsconfig.json --noEmit"
      }
    }
  }
}
