{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ui",
  "sourceRoot": "packages/ui/src",
  "projectType": "library",
  "tags": [
    "type:package",
    "scope:ui"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint {projectRoot}/src --ext .ts,.tsx"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root {projectRoot} --passWithNoTests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/ui/tsconfig.json --noEmit"
      }
    }
  }
}
