{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

    "Tenants": {
      "Entries": []
    },

    "Authentication": {
      "Issuer": "",
      "Audiences": [],
      "SigningKeys": []
    },

    "Relay": {
      "BatchSize": 200,
      "BusyInterval": "00:00:00.100",
      "IdleInterval": "00:00:02"
    },

    "Serilog": {
      "Using": [ "Serilog.Sinks.Console" ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft.AspNetCore": "Warning",
          "Microsoft.Hosting.Lifetime": "Information"
        }
      },
      "Enrich": [
        "FromLogContext"
      ]
    },

    "AllowedHosts": "*"
  }