# The front end: aster.ainfinite.ai
#
# Everything goes to the node process on :4173 — the pages, the assets, and the
# package routes it answers itself. There is deliberately no `location /api/`
# here. One used to send /api/ to :8787, and because the accounts service has no
# /api/index, /api/session, /api/tooltips or /api/domains, the effect was not to
# reroute those routes but to delete them: a 404 carrying FastAPI's
# {"detail":"Not Found"} from routes the node server plainly defines.
#
# The browser calls asterapi.ainfinite.ai for every API read now, so nothing on
# this name needs a path split at all.
#
# Install:
#   sudo cp deploy/nginx/aster.ainfinite.ai /etc/nginx/sites-available/
#   sudo ln -sf /etc/nginx/sites-available/aster.ainfinite.ai /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {

    server_name aster.ainfinite.ai;

    location / {
        proxy_pass http://127.0.0.1:4173;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_read_timeout 120s;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/aster.ainfinite.ai/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/aster.ainfinite.ai/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {

    if ($host = aster.ainfinite.ai) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;

    server_name aster.ainfinite.ai;
    return 404; # managed by Certbot

}
